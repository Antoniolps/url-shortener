# Postgres (source of truth) — porta 5433 no host, ver docker-compose.yml
DATABASE_URL="postgresql://url_shortener:url_shortener@localhost:5433/url_shortener?schema=public"

# Redis (cache-aside do redirect) — porta 6380 no host
REDIS_URL="redis://localhost:6380"

# RabbitMQ (eventos de clique) — porta 5673 no host (management: 15673)
RABBITMQ_URL="amqp://url_shortener:url_shortener@localhost:5673"

# Base pública usada para montar a shortUrl retornada pelo POST /urls
BASE_URL="http://localhost:3000"
